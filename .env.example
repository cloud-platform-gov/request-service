# Copy to .env for local use. No real secrets belong in this file.
# Empty values are treated as unset.

NODE_ENV=development
HOST=0.0.0.0
# 4003 is the port the API Gateway expects for the Request Service.
PORT=4003
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. Local-only credentials matching docker-compose.yml (host port 5434).
DATABASE_URL=postgres://requests:requests@localhost:5434/requests

# Required. Must be the SAME secret and issuer as the Identity Service, which
# issues the tokens. At least 32 bytes. The service refuses to start while it is empty.
JWT_SECRET=
JWT_ISSUER=cloud-platform-gov-identity

# Required. Local-only credentials matching docker-compose.yml.
RABBITMQ_URL=amqp://requests:requests@localhost:5672
# Durable topic exchange for domain events; routing key = event type.
RABBITMQ_EXCHANGE=cloud-platform-gov.events
# Max wait (ms) for connecting to the broker and for a publisher confirm.
RABBITMQ_PUBLISH_TIMEOUT_MS=5000

# Comma-separated exact origins allowed by CORS (e.g. http://localhost:5173).
# Empty means no cross-origin browser access.
CORS_ORIGIN=

# Tests only (`npm test`). Must point at a database whose name ends in _test.
# Started by `npm run test:db:up`.
TEST_DATABASE_URL=postgres://requests:requests@localhost:5435/requests_test
